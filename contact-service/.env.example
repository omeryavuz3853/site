# Use the SMTP host shown in YOUR Zoho account, according to your account region.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# An address or verified alias authorized for SMTP_USER, not the visitor's email.
SMTP_FROM=
ALLOWED_ORIGINS=https://omeryavuz.net,https://www.omeryavuz.net,https://omeryavuz.com,https://www.omeryavuz.com
PORT=3000
# Set only to your deployment provider's documented trusted reverse-proxy count.
TRUST_PROXY_HOPS=0
